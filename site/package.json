    "fastify": "^5.12.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "react-zoom-pan-pinch": "^4.2.0",
    "shiki": "^4.5.0",
    "yaml": "^2.9.1"
