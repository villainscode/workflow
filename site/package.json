{
  "name": "workflow-site",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/free-ports.mjs",
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc",
    "check:textedit": "tsx scripts/textedit-check.ts",
    "test": "node --import tsx --test test/unit.test.ts test/markdown.test.ts test/textedit.test.ts test/api.test.ts test/mcp.test.ts",
    "test:ui": "node --import tsx --test test/ui.test.ts",
    "test:all": "npm test && npm run test:ui"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.5",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tanstack/react-query": "^5.104.1",
    "@types/hast": "^3.0.5",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "deepmerge-ts": "^8.0.2",
    "diff": "^9.0.0",
    "docx-preview": "^0.4.1",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "htmlparser2": "^12.0.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.52.0",
    "mermaid": "^12.1.0",
    "parse5": "^8.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "react-zoom-pan-pinch": "^4.2.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.5.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "react-grab": "^0.2.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
